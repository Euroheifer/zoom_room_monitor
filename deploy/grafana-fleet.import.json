  {
   "datasource": {
    "type": "alexanderzobnin-zabbix-datasource",
    "uid": "${DS_ZABBIX}"
   },
   "gridPos": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 10
   },
   "id": 6,
   "title": "Active issues \u2014 all regions (includes collector watchdogs)",
   "type": "table",
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Host"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Room history (30d)",
          "url": "/d/zoom-room-detail?var-room=${__data.fields.Host:percentencode}&from=now-30d&to=now"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Severity"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "Not classified",
            "color": "rgb(108, 108, 108)"
           },
           "1": {
            "text": "Information",
            "color": "rgb(120, 158, 183)"
           },
           "2": {
            "text": "Warning",
            "color": "rgb(175, 180, 36)"
           },
           "3": {
            "text": "Medium",
            "color": "rgb(255, 137, 30)"
           },
           "4": {
            "text": "High",
            "color": "rgb(255, 101, 72)"
           },
           "5": {
            "text": "Disaster",
            "color": "rgb(215, 0, 0)"
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "cellHeight": "sm",
    "footer": {
     "show": false
    },
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Time",
      "desc": true
     }
    ]
   },
   "transformations": [
    {
     "id": "extractFields",
     "options": {
      "source": "Problems",
      "format": "json",
      "replace": true,
      "jsonPaths": [
       {
        "path": "timestamp",
        "alias": "Time"
       },
       {
        "path": "hosts[0].name",
        "alias": "host"
       },
       {
        "path": "severity",
        "alias": "Severity"
       },
       {
        "path": "name",
        "alias": "Problem"
       }
      ]
     }
    },
    {
     "id": "convertFieldType",
     "options": {
      "conversions": [
       {
        "targetField": "Time",
        "destinationType": "time",
        "dateFormat": "X"
       }
      ]
     }
    },
    {
     "id": "organize",
     "options": {
      "indexByName": {
       "Time": 0,
       "host": 1,
       "Severity": 2,
       "Problem": 3
      },
      "excludeByName": {},
      "renameByName": {
       "host": "Host"
      }
     }
    }
   ],
   "targets": [
    {
     "refId": "A",
     "queryType": "5",
     "schema": 12,
     "showProblems": "problems",
     "datasource": {
      "type": "alexanderzobnin-zabbix-datasource",
      "uid": "${DS_ZABBIX}"
     },
     "functions": [],
     "evaltype": "0",
     "application": {
      "filter": ""
     },
     "group": {
      "filter": "/^Rooms\\//"
     },
     "host": {
      "filter": "/.*/"
     },
     "item": {
      "filter": ""
     },
     "itemTag": {
      "filter": ""
     },
     "macro": {
      "filter": ""
     },
     "proxy": {
      "filter": ""
     },
     "tags": {
      "filter": ""
     },
     "trigger": {
      "filter": ""
     },
     "textFilter": "",
     "countTriggersBy": "",
     "options": {
      "acknowledged": 2,
      "count": false,
      "disableDataAlignment": false,
      "hostProxy": false,
      "hostsInMaintenance": false,
      "limit": 200,
      "minSeverity": 0,
      "showDisabledItems": false,
      "skipEmptyValues": false,
      "sortProblems": "default",
      "useTimeRange": false,
      "useTrends": "default",
      "useZabbixValueMapping": false
     },
     "resultFormat": "table",
     "table": {
      "skipEmptyValues": false
     }
    }
   ]
  }
 ],
