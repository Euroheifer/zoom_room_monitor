    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "auto",
    "orientation": "auto",
    "textMode": "value_and_name",
    "wideLayout": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "transformations": [
    {
     "id": "renameByRegex",
     "options": {
      "regex": "^(.*) Fleet Summary.*",
      "renamePattern": "$1"
