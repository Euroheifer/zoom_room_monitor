    "type": "alexanderzobnin-zabbix-datasource",
    "uid": "${DS_ZABBIX}"
   },
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 4
   },
   "description": "One tile per region. Click a tile for that region's rooms.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "links": [
      {
       "title": "Open ${__field.name} region dashboard",
       "url": "/d/zoom-region?var-region=${__field.name}"
      }
     ]
    },
    "overrides": []
   },
