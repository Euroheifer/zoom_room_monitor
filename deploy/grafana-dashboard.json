        "title": "Active issues (SG) — click a row for 30-day room history",
        "type": "table",
        "fieldConfig": {
          "defaults": {
            "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": false },
            "links": [
              {
                "title": "Room history (30d)",
                "url": "/d/zoom-room-detail?var-room=${__data.fields.host:percentencode}&from=now-30d&to=now"
              }
            ]
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Severity" },
              "properties": [
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "0": { "text": "Not classified" },
                        "1": { "text": "Information" },
                        "2": { "text": "Warning" },
                        "3": { "text": "Average" },
                        "4": { "text": "High" },
                        "5": { "text": "Disaster" }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        "options": {
          "cellHeight": "sm",
          "footer": { "show": false },
          "showHeader": true,
          "sortBy": [{ "displayName": "Time", "desc": true }]
        },
        "transformations": [
          {
            "id": "extractFields",
            "options": {
              "source": "Problems",
              "format": "json",
              "replace": true,
              "jsonPaths": [
                { "path": "timestamp", "alias": "Time" },
                { "path": "hosts[0].name", "alias": "host" },
                { "path": "severity", "alias": "Severity" },
                { "path": "name", "alias": "Problem" },
                { "path": "tags", "alias": "Tags" }
              ]
            }
          },
          {
            "id": "convertFieldType",
            "options": {
              "conversions": [
                { "targetField": "Time", "destinationType": "time", "dateFormat": "X" }
              ]
            }
          },
          {
            "id": "organize",
            "options": {
              "indexByName": {
                "Time": 0,
                "host": 1,
                "Severity": 2,
                "Problem": 3,
                "Tags": 4
              },
              "excludeByName": {},
              "renameByName": {}
            }
          }
